# DropShare — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ──────────────────────────────────────────────
# Server
# ──────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ──────────────────────────────────────────────
# Database (PostgreSQL)
# ──────────────────────────────────────────────
# Local Docker Compose default:
DATABASE_URL=postgresql://dropshare:dropshare_pass@localhost:5432/dropshare

# ──────────────────────────────────────────────
# Redis
# ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ──────────────────────────────────────────────
# JWT
# ──────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_EXPIRES_IN=7d

# ──────────────────────────────────────────────
# CORS / Client URL
# ──────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ──────────────────────────────────────────────
# Transfer Configuration
# ──────────────────────────────────────────────
# Chunk size in bytes (default 1 MB — tune for your use case)
# Smaller = finer progress + lower retry cost; Larger = better throughput
CHUNK_SIZE_BYTES=1048576

# Maximum file size (default 5 GB)
MAX_FILE_SIZE_BYTES=5368709120

# Maximum chunks in flight before waiting for ACKs (application-level flow control)
# This is NOT TCP congestion control — TCP handles its own windowing.
# This limits application memory usage and prevents socket buffer overflow.
MAX_IN_FLIGHT_CHUNKS=8

# How often (in chunks) to persist last_confirmed_chunk to PostgreSQL.
# We do NOT write every ACK to the DB to avoid thousands of writes on large files.
# This creates recovery checkpoints at a sensible interval.
DB_CHECKPOINT_INTERVAL=50
